                </p>

                <div class="technology">
                    <span>HTML</span>
                    <span>CSS</span>
                    <span>JavaScript</span>
                </div>

            </div>


            <div class="project-card">

                <h3>
                    Programming Portfolio
                </h3>

                <p>
                    A personal profile website presenting
                    education, skills, projects, and
                    programming interests.
                </p>

                <div class="technology">
                    <span>HTML</span>
                    <span>CSS</span>
                    <span>JavaScript</span>
                </div>

            </div>

        </div>

    </section>


    <!-- CONTACT -->
    <section class="contact" id="contact">

        <h2 class="section-title">
            Contact Me
        </h2>

        <form class="contact-form"
              onsubmit="sendMessage(event)">

            <input
                type="text"
                placeholder="Your Name"
                required
            >

            <input
                type="email"
                placeholder="Your Email"
                required
            >

            <textarea
                placeholder="Your Message"
                required
            ></textarea>

            <button
                type="submit"
                class="btn"
            >
                Send Message
            </button>

        </form>

    </section>


    <!-- FOOTER -->
    <footer>

        <p>
            © 2026 Ruby Ann | Programming Profile
        </p>

    </footer>


    <!-- JAVASCRIPT -->
    <script>

        function sendMessage(event) {

            event.preventDefault();

            alert(
                "Thank you! Your message has been received. This is a demo form."
            );

            event.target.reset();
        }

    </script>

</body>
</html>
